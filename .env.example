# Runtime environment: development, test, or production
EMIPREDICT_ENV=development

# Keep the dataset outside Git. Copy or move it here before Phase 1.
EMIPREDICT_DATA_PATH=data/raw/emi_prediction_dataset.csv

# Local development services. These contain no credentials.
EMIPREDICT_DATABASE_URL=sqlite:///data/emipredict.db
EMIPREDICT_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
EMIPREDICT_MLFLOW_ARTIFACT_ROOT=artifacts/mlflow

# Logging
EMIPREDICT_LOG_LEVEL=INFO

